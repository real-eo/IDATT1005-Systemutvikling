<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="no.ntnu.idatx1005.hmh.controller.OrganizationListController"
      spacing="15.0" prefHeight="700.0" prefWidth="1000.0">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Title -->
    <Label text="Organizations" styleClass="title"/>
    <Separator/>

    <!-- Filter Controls -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>

        <Label text="Search:"/>
        <TextField fx:id="searchField" onKeyReleased="#handleSearch"
                   promptText="Search organizations..." prefWidth="250.0"/>

        <Label text="Category:">
            <HBox.margin>
                <Insets left="20.0"/>
            </HBox.margin>
        </Label>
        <ComboBox fx:id="categoryFilter" onAction="#handleCategoryFilter"
                  prefWidth="150.0" promptText="All Categories"/>

        <CheckBox fx:id="verifiedOnlyCheckBox" text="Verified Only"
                  onAction="#handleVerifiedFilter">
            <HBox.margin>
                <Insets left="20.0"/>
            </HBox.margin>
        </CheckBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
                styleClass="secondary-button"/>
    </HBox>

    <!-- Organization Table -->
    <TableView fx:id="organizationTable" VBox.vgrow="ALWAYS"
               onMouseClicked="#handleOrganizationSelection">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="300.0"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150.0"/>
            <TableColumn fx:id="verifiedColumn" text="Verified" prefWidth="100.0"/>
        </columns>
    </TableView>

    <!-- Status Bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>

        <Label fx:id="statusLabel" styleClass="status-message"/>
    </HBox>

</VBox>
